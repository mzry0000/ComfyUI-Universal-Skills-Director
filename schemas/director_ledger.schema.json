{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniversalSkillsDirectorLedger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_revision",
    "plan_signature",
    "ledger_revision",
    "items",
    "receipts",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^dir_[0-9a-f]{20}$"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "plan_signature": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ledger_revision": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "shot_id",
          "variant_id",
          "stage_id",
          "status",
          "attempt",
          "dependency_signature",
          "prompt_id",
          "workflow_id",
          "output_refs",
          "error_code",
          "error_message",
          "updated_at"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[^:]+:[^:]+:[^:]+$"
          },
          "shot_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "variant_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "stage_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "selected",
              "assembled",
              "stale"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "dependency_signature": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "prompt_id": {
            "type": "string",
            "maxLength": 512
          },
          "workflow_id": {
            "type": "string",
            "maxLength": 512
          },
          "output_refs": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "\\S",
              "maxLength": 4096
            }
          },
          "error_code": {
            "type": "string",
            "maxLength": 256
          },
          "error_message": {
            "type": "string",
            "maxLength": 4096
          },
          "updated_at": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "receipts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_id",
          "item_id",
          "from_status",
          "to_status",
          "attempt",
          "dependency_signature",
          "prompt_id",
          "workflow_id",
          "output_refs",
          "error_code",
          "error_message",
          "recorded_at"
        ],
        "properties": {
          "receipt_id": {
            "type": "string",
            "pattern": "^receipt_[0-9a-f]{20}$"
          },
          "item_id": {
            "type": "string",
            "pattern": "^[^:]+:[^:]+:[^:]+$"
          },
          "from_status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "selected",
              "assembled",
              "stale"
            ]
          },
          "to_status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "selected",
              "assembled",
              "stale"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "dependency_signature": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "prompt_id": {
            "type": "string",
            "maxLength": 512
          },
          "workflow_id": {
            "type": "string",
            "maxLength": 512
          },
          "output_refs": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "\\S",
              "maxLength": 4096
            }
          },
          "error_code": {
            "type": "string",
            "maxLength": 256
          },
          "error_message": {
            "type": "string",
            "maxLength": 4096
          },
          "recorded_at": {
            "type": "string",
            "pattern": "\\S",
            "maxLength": 128
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 128
    },
    "updated_at": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 128
    }
  }
}
