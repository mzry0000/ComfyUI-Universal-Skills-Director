{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniversalDirectorPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "revision",
    "plan_signature",
    "director_profile",
    "target_profile",
    "title",
    "goal",
    "specification",
    "brief_fingerprint",
    "assets",
    "globals",
    "scenes",
    "warnings",
    "summary"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^dir_[0-9a-f]{20}$"},
    "revision": {"type": "integer", "minimum": 1},
    "plan_signature": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "director_profile": {
      "type": "string",
      "enum": ["generic", "music_video", "business_ad", "ugc_ad", "short_film"]
    },
    "target_profile": {
      "type": "string",
      "enum": [
        "gpt_image_2",
        "generic_image_generation",
        "generic_image_edit",
        "anime_diffusion",
        "photoreal_diffusion",
        "video_generation",
        "video_image_to_video",
        "text_generation",
        "structured_json",
        "custom"
      ]
    },
    "title": {"type": "string", "pattern": "\\S", "maxLength": 500},
    "goal": {"type": "string", "pattern": "\\S", "maxLength": 4000},
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_format", "source_file", "fingerprint"],
      "properties": {
        "name": {"type": "string", "pattern": "\\S", "maxLength": 200},
        "version": {"type": "string", "maxLength": 100},
        "source_format": {"type": "string", "enum": ["markdown", "json"]},
        "source_file": {"type": "string", "pattern": "\\S", "maxLength": 500},
        "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "brief_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "assets": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "kind", "source_input", "role", "preserve", "fingerprint"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "kind": {"type": "string", "enum": ["image", "audio", "video", "text"]},
          "source_input": {"type": "string", "pattern": "\\S", "maxLength": 500},
          "role": {"type": "string", "pattern": "\\S", "maxLength": 1000},
          "preserve": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 1000}},
          "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "globals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "aspect_ratio", "continuity", "constraints"],
      "properties": {
        "style": {"type": "string", "maxLength": 4000},
        "aspect_ratio": {"type": "string", "maxLength": 100},
        "continuity": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 1000}},
        "constraints": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 1000}}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "order", "title", "summary", "start_seconds", "duration_seconds", "shots"],
        "properties": {
          "scene_id": {"type": "string", "pattern": "^scene-[0-9]{3,4}$"},
          "order": {"type": "integer", "minimum": 1, "maximum": 9999},
          "title": {"type": "string", "pattern": "\\S", "maxLength": 500},
          "summary": {"type": "string", "maxLength": 2000},
          "start_seconds": {"type": ["number", "null"], "minimum": 0, "maximum": 86400, "description": "Absolute project start; null places the scene sequentially."},
          "duration_seconds": {"type": "number", "minimum": 0.001, "maximum": 86400},
          "shots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["shot_id", "order", "title", "shot_type", "prompt", "camera", "timing", "content", "references", "stages", "variants", "tags", "constraints"],
              "properties": {
                "shot_id": {"type": "string", "pattern": "^scene-[0-9]{3,4}-shot-[0-9]{3,4}$"},
                "order": {"type": "integer", "minimum": 1, "maximum": 9999},
                "title": {"type": "string", "pattern": "\\S", "maxLength": 500},
                "shot_type": {"type": "string", "pattern": "\\S", "maxLength": 200},
                "prompt": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["keyframe", "motion", "negative"],
                  "properties": {
                    "keyframe": {"type": "string", "maxLength": 8000},
                    "motion": {"type": "string", "maxLength": 8000},
                    "negative": {"type": "string", "maxLength": 4000}
                  }
                },
                "camera": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["framing", "angle", "movement", "lens"],
                  "properties": {
                    "framing": {"type": "string", "maxLength": 1000},
                    "angle": {"type": "string", "maxLength": 1000},
                    "movement": {"type": "string", "maxLength": 1000},
                    "lens": {"type": "string", "maxLength": 1000}
                  }
                },
                "timing": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["start_seconds", "duration_seconds", "fps"],
                  "properties": {
                    "start_seconds": {"type": ["number", "null"], "minimum": 0, "maximum": 86400, "description": "Offset from the containing scene start; null places the shot sequentially."},
                    "duration_seconds": {"type": "number", "minimum": 0.001, "maximum": 86400},
                    "fps": {"type": ["number", "null"], "minimum": 1, "maximum": 240}
                  }
                },
                "content": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["dialogue", "lyric_moment", "text_overlay", "product_action"],
                  "properties": {
                    "dialogue": {"type": "string", "maxLength": 4000},
                    "lyric_moment": {"type": "string", "maxLength": 4000},
                    "text_overlay": {"type": "string", "maxLength": 2000},
                    "product_action": {"type": "string", "maxLength": 2000}
                  }
                },
                "references": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["asset_id", "role", "preserve"],
                    "properties": {
                      "asset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
                      "role": {"type": "string", "maxLength": 1000},
                      "preserve": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 1000}}
                    }
                  }
                },
                "stages": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["stage_id", "order", "kind", "target_profile", "workflow_hint", "depends_on"],
                    "properties": {
                      "stage_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
                      "order": {"type": "integer", "minimum": 1, "maximum": 99},
                      "kind": {"type": "string", "enum": ["image", "video", "audio", "text"]},
                      "target_profile": {
                        "type": "string",
                        "enum": ["gpt_image_2", "generic_image_generation", "generic_image_edit", "anime_diffusion", "photoreal_diffusion", "video_generation", "video_image_to_video", "text_generation", "structured_json", "custom"]
                      },
                      "workflow_hint": {"type": "string", "maxLength": 500},
                      "depends_on": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}}
                    }
                  }
                },
                "variants": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["variant_id", "order", "label", "angle", "take", "seed"],
                    "properties": {
                      "variant_id": {"type": "string", "pattern": "^scene-[0-9]{3,4}-shot-[0-9]{3,4}-variant-[0-9]{3}$"},
                      "order": {"type": "integer", "minimum": 1, "maximum": 999},
                      "label": {"type": "string", "maxLength": 500},
                      "angle": {"type": "string", "maxLength": 500},
                      "take": {"type": "integer", "minimum": 1, "maximum": 999},
                      "seed": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807}
                    }
                  }
                },
                "tags": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 200}},
                "constraints": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 1000}}
              }
            }
          }
        }
      }
    },
    "warnings": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 2000}},
    "summary": {"type": "string", "pattern": "\\S", "maxLength": 4000}
  }
}
