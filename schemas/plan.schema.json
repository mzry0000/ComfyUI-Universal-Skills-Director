{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniversalSkillPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_type",
    "goal",
    "target_profile",
    "input_roles",
    "required_changes",
    "preserve",
    "constraints",
    "composition",
    "text_elements",
    "motion",
    "downstream_prompt",
    "warnings",
    "summary"
  ],
  "properties": {
    "task_type": {
      "type": "string",
      "pattern": "\\S",
      "description": "Model-independent task classification, such as image_edit or video_generation."
    },
    "goal": {
      "type": "string",
      "pattern": "\\S"
    },
    "target_profile": {
      "type": "string",
      "enum": [
        "gpt_image_2",
        "generic_image_generation",
        "generic_image_edit",
        "anime_diffusion",
        "photoreal_diffusion",
        "video_generation",
        "video_image_to_video",
        "text_generation",
        "structured_json",
        "custom"
      ]
    },
    "input_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "role", "preserve"],
        "properties": {
          "input": {"type": "string", "pattern": "\\S"},
          "role": {"type": "string", "pattern": "\\S"},
          "preserve": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "required_changes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "preserve": {
      "type": "array",
      "items": {"type": "string"}
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "framing",
        "layout",
        "camera_angle",
        "lighting",
        "background",
        "style"
      ],
      "properties": {
        "aspect_ratio": {"type": "string"},
        "framing": {"type": "string"},
        "layout": {"type": "string"},
        "camera_angle": {"type": "string"},
        "lighting": {"type": "string"},
        "background": {"type": "string"},
        "style": {"type": "string"}
      }
    },
    "text_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "priority", "placement"],
        "properties": {
          "text": {"type": "string"},
          "priority": {"type": "integer", "minimum": 1},
          "placement": {"type": "string"}
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_state",
        "timeline",
        "subject_motion",
        "camera_motion",
        "end_state",
        "preserve",
        "forbidden_motion"
      ],
      "properties": {
        "start_state": {"type": "string"},
        "timeline": {
          "type": "array",
          "items": {"type": "string"}
        },
        "subject_motion": {"type": "string"},
        "camera_motion": {"type": "string"},
        "end_state": {"type": "string"},
        "preserve": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_motion": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "downstream_prompt": {
      "type": "string",
      "pattern": "\\S",
      "description": "A model-produced draft. The Target Adapter remains authoritative for final_prompt."
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {
      "type": "string",
      "pattern": "\\S"
    }
  }
}
