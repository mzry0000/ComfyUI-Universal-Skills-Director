{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniversalSkillsTimelineManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "plan_id",
    "plan_revision",
    "plan_signature",
    "ledger_revision",
    "duration_seconds",
    "tracks",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^timeline_[0-9a-f]{20}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^dir_[0-9a-f]{20}$"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "plan_signature": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ledger_revision": {
      "type": "integer",
      "minimum": 0
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["track_id", "kind", "label", "clips"],
        "properties": {
          "track_id": {
            "type": "string",
            "pattern": "^track-[0-9]{3}$"
          },
          "kind": {
            "type": "string",
            "enum": ["video", "audio"]
          },
          "label": {
            "type": "string",
            "pattern": "\\S",
            "maxLength": 256
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clip_id",
                "item_id",
                "scene_id",
                "shot_id",
                "variant_id",
                "stage_id",
                "asset_ref",
                "timeline_start_seconds",
                "source_start_seconds",
                "duration_seconds",
                "speed",
                "sync_lock",
                "sync_group"
              ],
              "properties": {
                "clip_id": {
                  "type": "string",
                  "pattern": "^clip_[0-9a-f]{20}$"
                },
                "item_id": {
                  "type": "string",
                  "pattern": "^[^:]+:[^:]+:[^:]+$"
                },
                "scene_id": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "shot_id": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "variant_id": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "stage_id": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "asset_ref": {
                  "type": "string",
                  "pattern": "\\S",
                  "maxLength": 4096
                },
                "timeline_start_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "source_start_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "duration_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "speed": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 16
                },
                "sync_lock": {
                  "type": "boolean"
                },
                "sync_group": {
                  "type": ["string", "null"],
                  "pattern": "\\S",
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
